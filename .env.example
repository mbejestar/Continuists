# Continuum Environment Configuration
# Project: CONTINUUM — The files remain. The context doesn't.

# Application
APP_ENV=production
DEBUG=false
APP_NAME=Continuum
APP_URL=https://continuum.example.com
API_V1_STR=/api

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=continuum_app
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=continuum_db
DATABASE_URL=postgresql+asyncpg://continuum_app:secure_postgres_password_here@localhost:5432/continuum_db
DATABASE_SYNC_URL=postgresql://continuum_app:secure_postgres_password_here@localhost:5432/continuum_db

# Security & Tokens
SECRET_KEY=generate_with_openssl_rand_hex_32_at_least_64_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["https://continuum.example.com","http://localhost:3000","http://localhost:5173"]

# Storage Service Configuration
# Allowed options: local, s3, azure_blob, gcs
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=continuum-documents-vault
STORAGE_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
LOCAL_STORAGE_DIR=/var/continuum/storage

# Storage Quotas
FREE_TIER_MISSION_STORAGE_BYTES=52428800 # 50 MB
PREMIUM_TIER_MAX_SINGLE_FILE_BYTES=1073741824 # 1 GB soft limit for infrastructure sanity

# Marketplace Fee Configuration
DIRECT_TRANSACTION_FEE_PERCENT=0.08  # 8% for direct discovery
ASSISTED_TRANSACTION_FEE_PERCENT=0.15 # 15% for assisted transactions
PLATFORM_CURRENCY=ZAR # South African Rand

# Payment Gateway (Integration Abstraction)
PAYMENT_GATEWAY_PROVIDER=paystack # or ozow, stripe
PAYMENT_PUBLIC_KEY=pk_live_xxxx
PAYMENT_SECRET_KEY=sk_live_xxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxx
PREMIUM_SUBSCRIPTION_MONTHLY_ZAR=100.00

# Biometric Verification (POPIA Compliant Verification Service)
BIOMETRIC_PROVIDER=veriff # or smiley, aws_rekognition, zero_knowledge
BIOMETRIC_API_KEY=your_biometric_api_key
BIOMETRIC_STORE_RAW_DATA=false # Strict POPIA constraint: NEVER store raw templates
